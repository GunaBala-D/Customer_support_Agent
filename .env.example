# Copy to .env and adjust. Never commit .env.

# --- LLM: Ollama is the primary (and only required) model server -------------------------
LLM_PROVIDER=ollama                # ollama | extractive (offline test double, not a real LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b           # any pulled instruct model, e.g. qwen2.5:3b, llama3.1:8b, phi3.5
OLLAMA_NUM_CTX=4096                # context window; smaller = faster on CPU / Apple Silicon
LLM_MAX_TOKENS=350
LLM_TEMPERATURE=0.1

# --- Embeddings (local) ---------------------------------------------------------------------
EMBEDDING_PROVIDER=ollama          # ollama | hash (lexical baseline for tests/offline)
EMBEDDING_MODEL=nomic-embed-text

# --- Storage -----------------------------------------------------------------------------------
# SQLite works out of the box. For PostgreSQL (docker compose does this for you):
# DATABASE_URL=postgresql+psycopg://support:CHANGE_ME@127.0.0.1:5432/support
DATABASE_URL=sqlite:///./data/app.db   # can also be changed later from the Settings page
CHROMA_PATH=./data/chroma
REDIS_URL=                          # e.g. redis://localhost:6379/0 ; empty = in-process cache
AUTO_SEED=true                      # seed demo data + ingest data/documents on first start

# --- RAG tuning (recalibrate with `make evaluate` when you change the embedding model) ----------
RAG_TOP_K=4
RAG_MIN_SCORE=0.30
MIN_GROUNDING=0.60
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# --- Security ----------------------------------------------------------------------------------
# Real logins use JWT. In development a JWT secret is generated for you and kept in data/runtime_settings.json.
# In production (APP_ENV=production) the app refuses to start without these:
JWT_SECRET=                         # python -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_EMAIL=admin@supportpilot.example
ADMIN_PASSWORD=                     # 12+ characters. Development default is a known demo password.
JWT_EXPIRE_MINUTES=60
SEED_DEMO_USERS=true                # development only: demo customer/agent logins (ignored in production)
ALLOW_RUNTIME_CONFIG=true           # false = the Settings page becomes read-only
# Optional static service credential for scripts/CI (acts as admin). Leave empty to disable.
ADMIN_API_KEY=
ALLOW_API_KEY=true
ALLOW_DEMO_IDENTITY=true            # X-Customer-Id demo header; never honoured in production
RATE_LIMIT_PER_MINUTE=30
APP_ENV=development                 # production disables the demo customer picker
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
